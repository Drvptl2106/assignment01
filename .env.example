# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Get these from https://developers.kite.trade after creating an app.
KITE_API_KEY=
KITE_API_SECRET=

# Leave empty for paper trading. Live orders need this exact phrase:
# LIVE_TRADING=I_UNDERSTAND_THE_RISK
LIVE_TRADING=

# Risk limits (rupees)
MAX_ORDER_VALUE=5000
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=3
MAX_ORDERS_PER_DAY=10
ALLOWED_SYMBOLS=INFY,TCS,RELIANCE,HDFCBANK

# Starting cash for paper trading / backtests
PAPER_CASH=100000
