# Copy to .env and fill in. .env is gitignored. Never commit real keys.
# Get these from https://developers.kite.trade after creating an app.
# This project is read-only: it never places, modifies or cancels orders.
KITE_API_KEY=
KITE_API_SECRET=

# Portfolio review rules (percent)
MAX_HOLDING_PCT=20
LOSS_ALERT_PCT=20
GAIN_ALERT_PCT=50
SECTOR_FILE=data/sectors.csv

# Paper trading / backtest settings (simulated money only)
PAPER_CASH=100000
MAX_ORDER_VALUE=5000
MAX_DAILY_LOSS=1000
MAX_OPEN_POSITIONS=3
MAX_ORDERS_PER_DAY=10
ALLOWED_SYMBOLS=INFY,TCS,RELIANCE,HDFCBANK
